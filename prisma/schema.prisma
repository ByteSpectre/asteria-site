// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  category     String
  excerpt      String?
  previewImage String?
  content      Json
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model ArticleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    String
  summary     String?
  pricing     Json?
  scopeItems  Json?
  faqItems    Json?
  cases       Json?
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([category])
}

model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([updatedAt])
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model CaptchaChallenge {
  id         String   @id @default(cuid())
  answerHash String
  codeCipher String?
  dedupeKey  String?  @unique
  audience   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model ContactFormToken {
  nonce     String   @id
  openedAt  BigInt
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
