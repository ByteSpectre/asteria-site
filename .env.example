DATABASE_URL="postgresql://asteria:change-me@localhost:5433/asteria?schema=public"
# For Supabase on Vercel:
# DATABASE_URL = Transaction pooler (:6543) for the Next.js runtime
# DIRECT_URL   = Direct connection db.<project>.supabase.co:5432 (required for migrate)
# DIRECT_URL="postgresql://postgres:change-me@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
ADMIN_LOGIN="admin@asteria.com"
ADMIN_PASSWORD_HASH="\$2b\$12\$replace-with-bcrypt-hash"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Canonical site origin for CSRF checks on admin uploads (required on custom domains).
SITE_URL="https://asteria-site-chi.vercel.app"
# Vercel Blob. На обычном Node.js-хостинге можно оставить пустым и использовать UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./storage/uploads"
# Contact / lead form via Nodemailer + SMTP.
# Примеры: smtp.yandex.ru:465, smtp.mail.ru:465, smtp.gmail.com:465
CONTACT_TO_EMAIL="leads@example.com"
CONTACT_FROM_EMAIL="Asteria <your@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# Set TRUST_PROXY=true only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP.
TRUST_PROXY="false"
