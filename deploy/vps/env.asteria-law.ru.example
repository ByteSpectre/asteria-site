# Шаблон для asteria-law.ru (без секретов — можно в git).
# cp deploy/vps/env.asteria-law.ru.example /var/www/asteria/.env
# Затем заполни пароли / хэш / SMTP. setup-regru.sh подставит DB/AUTH, если оставлены плейсхолдеры.

NODE_ENV=production

DATABASE_URL="postgresql://asteria:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/asteria?schema=public"
DIRECT_URL="postgresql://asteria:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/asteria?schema=public"

ADMIN_LOGIN="admin@asteria-law.ru"
# node -e "require('bcryptjs').hash('ваш_пароль',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64="replace-with-base64-of-bcrypt-hash"
AUTH_SECRET="replace-with-at-least-32-random-characters"

SITE_URL="https://asteria-law.ru"
TRUST_PROXY="true"
TRUST_CLOUDFLARE="false"

BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="/var/www/asteria/storage/uploads"

CONTACT_TO_EMAIL="asteria.law@yandex.ru"
CONTACT_FROM_EMAIL="Asteria <asteria.law@yandex.ru>"
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="asteria.law@yandex.ru"
SMTP_PASS=""
