# Локальная проверка в WSL Ubuntu (production-like, без VPS).
# cp deploy/vps/env.wsl.example .env

NODE_ENV=production

# Docker Compose из корня репозитория: порт 5433
DATABASE_URL="postgresql://asteria:asteria_dev@127.0.0.1:5433/asteria?schema=public"
DIRECT_URL="postgresql://asteria:asteria_dev@127.0.0.1:5433/asteria?schema=public"
# Если Postgres через apt в WSL — используйте порт 5432:
# DATABASE_URL="postgresql://asteria:asteria_dev@127.0.0.1:5432/asteria?schema=public"
# DIRECT_URL="postgresql://asteria:asteria_dev@127.0.0.1:5432/asteria?schema=public"

ADMIN_LOGIN="admin@asteria.com"
# Prefer base64 — Next.js dotenv expands "$..." and breaks raw bcrypt hashes.
# node -e "require('bcryptjs').hash('admin123',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64="replace-with-base64-of-bcrypt-hash"
# Optional fallback (often broken on Linux/Next): ADMIN_PASSWORD_HASH='$2b$12$...'
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Без HTTPS в WSL — совпадает с адресом в браузере (обязательно http://, не https://)
# Иначе cookies secure=true и вход/капча в админке не работают.
SITE_URL="http://127.0.0.1:3000"
TRUST_PROXY="false"

BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./storage/uploads"

# Опционально: для проверки формы заявок
CONTACT_TO_EMAIL="leads@example.com"
CONTACT_FROM_EMAIL="Asteria <your@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
