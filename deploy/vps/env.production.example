# Среда для VPS на чистом Ubuntu. Скопируйте в корень проекта как `.env`.
# cp deploy/vps/env.production.example .env

NODE_ENV=production

# PostgreSQL на этом же сервере (без Supabase)
# Создайте пользователя/БД: см. deploy/vps/INSTRUCTION.md или postgres-init.sql
DATABASE_URL="postgresql://asteria:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/asteria?schema=public"
DIRECT_URL="postgresql://asteria:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/asteria?schema=public"

ADMIN_LOGIN="admin@asteria.com"
# Prefer base64 — Next.js dotenv corrupts raw bcrypt "$" hashes:
# node -e "require('bcryptjs').hash('ваш_пароль',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_PASSWORD_HASH_B64="replace-with-base64-of-bcrypt-hash"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Боевой домен (обязательно https)
SITE_URL="https://example.ru"
# За Nginx всегда true
TRUST_PROXY="true"

# Файлы редактора на диске (не Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="/var/www/asteria/storage/uploads"

# Почта заявок (Nodemailer)
CONTACT_TO_EMAIL="leads@example.ru"
CONTACT_FROM_EMAIL="Asteria <noreply@example.ru>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
